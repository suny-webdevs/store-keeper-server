# Store Keeper Server — Environment Variables
# Copy this file to .env and fill in your values

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Redis ──────────────────────────────────────────────────
# How to get your REDIS_URL:
#
# Option A: Cloud / Managed Redis via Upstash (Recommended for Supabase integration & free tier)
#   1. Sign up or log in at https://console.upstash.com
#   2. Click "Create Database", give it a name (e.g., store-keeper-redis), and pick a primary region.
#   3. Once created, scroll to the "Connect" section on the database details page.
#   4. Select the "ioredis" or "Node" tab.
#   5. Copy the standard connection string (e.g., rediss://default:<password>@<endpoint>.upstash.io:6379).
#   6. Paste it below as REDIS_URL.
#
# Option B: Local Redis via Docker (Fastest for offline local development)
#   1. Run: docker run -d --name store-keeper-redis -p 6379:6379 redis:7-alpine
#   2. Set: REDIS_URL=redis://localhost:6379
#
# Option C: Local Redis via Homebrew (macOS)
#   1. Run: brew install redis && brew services start redis
#   2. Set: REDIS_URL=redis://localhost:6379
#
REDIS_URL=redis://default:password@your-redis-host:6379

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Application ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Sentry ─────────────────────────────────────────────────
# How to get your SENTRY_DSN:
# (Optional in local development — leave blank to disable Sentry error tracking)
#
#   1. Sign up or log in at https://sentry.io
#   2. Navigate to "Projects" from the left sidebar and click "Create Project".
#   3. Under platform selection, choose "Node.js" or "NestJS".
#   4. Enter a project name (e.g., store-keeper-server) and click "Create Project".
#   5. Sentry will present your DSN immediately on the setup screen.
#      (Or find it anytime under: Project Settings > Client Keys (DSN)).
#   6. Copy the DSN URL (format: https://<key>@o<org>.ingest.sentry.io/<project_id>).
#   7. Paste it below as SENTRY_DSN.
#
SENTRY_DSN=

# ── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
